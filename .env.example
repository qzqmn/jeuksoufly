# ===== 基本 =====
BASE_URL=https://jeuksoufly.example.com
DB_PATH=/data/jeuksoufly.db

# ===== 後台 (/admin) =====
ADMIN_USER=admin
ADMIN_PASSWORD=請改成長密碼
ADMIN_CHAT_IDS=            # 你的 Telegram chat_id,可多個用逗號分隔,可用 /grantvip

# ===== Telegram Bot (@BotFather 申請) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=      # 不含 @,用於網站上的訂閱按鈕

# ===== 機票數據 (Travelpayouts / Aviasales Data API) =====
TP_TOKEN=
TP_MARKER=                  # 你的 affiliate marker
ROUTES=HKG-TYO,HKG-OSA,HKG-BKK,HKG-TPE,HKG-SEL,HKG-SIN
MONTHS_AHEAD=4

# ===== 行為 =====
FREE_DELAY_MIN=30           # 免費用戶延遲分鐘
POLL_MINUTES=30             # 抓取間隔
FREE_ALERT_LIMIT=2          # 免費用戶價格提醒上限
DEAL_DROP_RATIO=0.85        # 低於近期中位數 85% 才算降價
# 如 VPS IP 被封,可經代理出去 (httpx 自動讀取):
# HTTPS_PROXY=http://user:pass@host:port

# ===== GitHub 構建的鏡像 / Cloudflare Tunnel (docker-compose 用) =====
GHCR_OWNER=你的GitHub用戶名小寫
TUNNEL_TOKEN=                # 在 Cloudflare Zero Trust 建立 Tunnel 後取得

# ===== Email (Resend.com,需驗證寄件域名) =====
RESEND_API_KEY=
MAIL_FROM=著數飛 <deals@你的域名>
DIGEST_HOUR_HKT=9

# ===== 付款 (Stripe) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # Webhook 網址: BASE_URL/stripe/webhook,事件: checkout.session.completed, invoice.paid

# ===== 第二票價來源 Ignav(可選;以上各 key 亦可在後台「整合設定」填寫,後台優先) =====
IGNAV_API_KEY=

# ===== 第三票價來源 SerpApi(Google Flights,可選;亦可在後台填) =====
SERPAPI_KEY=

# ===== 促銷頁 AI 抽取(Anthropic API;亦可在後台填) =====
ANTHROPIC_API_KEY=
