# 注意:註解請獨立一行,不要寫在 KEY=值 同一行(docker compose 會把行內註解當成值)。
# 以下大部分金鑰也可之後在後台「整合設定」填寫(後台優先)。

# ---- 基本 ----
BASE_URL=https://你的網址
DB_PATH=/data/jeuksoufly.db

# ---- 後台 /admin ----
ADMIN_USER=admin
# 請改成長密碼(密碼內避免出現「空格+#」)
ADMIN_PASSWORD=請改成長密碼
# 你的 Telegram chat_id,多個用逗號分隔
ADMIN_CHAT_IDS=

# ---- Telegram Bot(@BotFather 申請) ----
TELEGRAM_BOT_TOKEN=
# Bot 用戶名,不含 @(例如 jeuksoufly_bot)
TELEGRAM_BOT_USERNAME=

# ---- 票價來源 ----
TP_TOKEN=
TP_MARKER=
IGNAV_API_KEY=
SERPAPI_KEY=
ROUTES=HKG-TYO,HKG-OSA,HKG-BKK,HKG-TPE,HKG-SEL,HKG-SIN
MONTHS_AHEAD=4

# ---- AI 促銷頁抽取 ----
ANTHROPIC_API_KEY=

# ---- Email(Resend,需驗證寄件域名) ----
RESEND_API_KEY=
MAIL_FROM=著數飛 <deals@你的域名>
DIGEST_HOUR_HKT=9

# ---- 付款(Stripe) ----
STRIPE_SECRET_KEY=
# Webhook 網址 BASE_URL/stripe/webhook;事件 checkout.session.completed、invoice.paid
STRIPE_WEBHOOK_SECRET=

# ---- 行為 ----
FREE_DELAY_MIN=30
POLL_MINUTES=30
FREE_ALERT_LIMIT=2
DEAL_DROP_RATIO=0.85

# ---- docker-compose ----
GHCR_OWNER=你的GitHub用戶名小寫
TUNNEL_TOKEN=
# 如 IP 被封可設代理:
# HTTPS_PROXY=http://user:pass@host:port
